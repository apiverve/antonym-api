            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "antonym",
        "antonym",
        "antonym api",
        "antonym tool",
        "antonym software",
        "antonym service"
    ],
    "homepage": "https://antonym.apiverve.com?utm_source=php&utm_medium=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/antonym",
        "source": "https://github.com/apiverve/antonym-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Antonym\\": "php/src/"
        }
    },
    "autoload-dev": {
